# Copy to ".env" for local backend dev (server/index.js loads it via dotenv).
# In production these are set in the Render dashboard (and Vercel for the api/* fallback).

# The Guardian — free, unlimited, real images + FULL article body via API.
# Get a key: https://open-platform.theguardian.com/access/
GUARDIAN_KEY=

# NewsData.io — free 200 credits/day, paginated, images.
# Register: https://newsdata.io/register
NEWSDATA_KEY=

# GNews — optional, small free tier (~100 req/day).
# https://gnews.io/
GNEWS_API_KEY=

# CORS allow-list for the Render server (comma-separated). Your frontend origin(s).
# Leave unset to allow all origins (handy in local dev).
ALLOWED_ORIGIN=http://localhost:4200

# Local server port (Render injects its own PORT automatically).
PORT=3000

# --- Optional: stronger free full-article scraping ---

# Jina AI Reader — free hosted headless render -> clean markdown ("Crawl4AI as a
# service"). Works without a key (rate-limited); a free key raises limits.
# Get one: https://jina.ai/reader/
JINA_API_KEY=

# --- Optional: LLM cleanup of scraped text (OpenAI-compatible: DeepSeek/OpenRouter/Groq) ---
# OFF unless LLM_API_KEY is set. DeepSeek is cheap-but-paid; point LLM_BASE_URL /
# LLM_MODEL at a free provider to stay free. Only runs on the Render backend.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# rescue = clean only weak extractions (default) | always | off
LLM_CLEAN=rescue
